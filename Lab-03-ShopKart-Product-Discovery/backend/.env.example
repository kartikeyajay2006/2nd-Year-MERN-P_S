PORT=3000
# Atlas or a local replica set is required for transactional order placement.
MONGO_URI=mongodb://127.0.0.1:27018/shopkart?replicaSet=shopkart
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
# Optional: cash on delivery works without payment credentials.
# Use only Razorpay TEST credentials. Never put the secret in frontend variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
